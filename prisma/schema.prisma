generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id              String          @id @default(uuid())
  name            String
  department      String
  tierLimit       Float
  tierLimitCurrency String        @default("INR")
  address         String          @default("Not Provided")
  designation     String          @default("Not Specified")
  rating          Float           @default(100)
  accessCode      String          @default("changeme")
  expenses        Expense[]
  payouts         MonthlyPayout[]
}

model ApiUsage {
  id    String @id @default(uuid())
  date  String @unique
  count Int    @default(0)
}

model Expense {
  id              String   @id @default(uuid())
  employeeId      String
  merchant        String
  amount          Float
  currency        String   @default("INR")
  amountUsd       Float?
  fxRate          Float?
  fxRateDate      DateTime?
  fxProvider      String?
  conversionStatus String  @default("NOT_NEEDED")
  timestamp       DateTime
  category        String
  lineItems       Json
  createdAt       DateTime @default(now())
  audit           Audit?
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Audit {
  id                      String    @id @default(uuid())
  expenseId               String    @unique
  calculatedReimbursement Float
  calculatedReimbursementUsd Float?
  policyLimitUsd          Float?
  riskScore               Int
  status                  String
  anomalies               Anomaly[]
  expense                 Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model Anomaly {
  id          String @id @default(uuid())
  auditId     String
  type        String
  description String
  severity    String
  audit       Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model MonthlyPayout {
  id                     String    @id @default(uuid())
  employeeId             String
  year                   Int
  month                  Int
  totalReimbursement     Float
  totalReimbursementUsd  Float?
  expenseCount           Int
  status                 String    @default("PENDING")
  closedAt               DateTime  @default(now())
  paidAt                 DateTime?
  categoryBreakdown      Json
  categoryBreakdownUsd   Json?
  totalClaimed           Float
  totalClaimedUsd        Float?
  employee               Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, month])
}
